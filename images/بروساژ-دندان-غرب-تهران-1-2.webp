    <style>
    .tsm-menu{position:fixed;inset:0;z-index:999999;display:none;}
    .tsm-menu.open{display:block;}
    .tsm-menu-backdrop{position:absolute;inset:0;background:rgba(10,17,32,.55);}
    .tsm-menu-panel{position:absolute;top:0;right:0;height:100%;width:82%;max-width:340px;background:linear-gradient(160deg,#F9E7B5 0%,#F2C94C 100%);box-shadow:-8px 0 30px rgba(0,0,0,.3);padding:64px 0 24px;overflow-y:auto;transform:translateX(100%);transition:transform .28s ease;}
    .tsm-menu.open .tsm-menu-panel{transform:translateX(0);}
    .tsm-menu-close{position:absolute;top:14px;left:14px;width:40px;height:40px;border:none;border-radius:50%;background:rgba(10,17,32,.12);color:#0A1120;font-size:26px;line-height:1;cursor:pointer;}
    .tsm-menu-list{list-style:none;margin:0;padding:0;}
    .tsm-menu-list li{border-bottom:1px solid rgba(10,17,32,.12);}
    .tsm-menu-list > li > a, .tsm-menu-list > li > .tsm-toggle{display:block;padding:15px 22px;color:#0A1120;font-weight:700;font-size:16px;text-decoration:none;font-family:inherit;cursor:pointer;}
    .tsm-menu-list > li > a:hover, .tsm-menu-list > li > .tsm-toggle:hover{background:rgba(10,17,32,.08);color:#B8860B;}
    .tsm-has-sub > .tsm-toggle{display:flex;justify-content:space-between;align-items:center;}
    .tsm-arrow{transition:transform .2s ease;font-size:13px;}
    .tsm-has-sub.open > .tsm-toggle .tsm-arrow{transform:rotate(180deg);}
    .tsm-sub{max-height:0;overflow:hidden;transition:max-height .3s ease;background:rgba(10,17,32,.05);}
    .tsm-has-sub.open > .tsm-sub{max-height:1400px;}
    .tsm-sub li a{padding:12px 34px;font-size:14.5px;font-weight:600;display:block;color:#0A1120;text-decoration:none;}
    .tsm-sub li a:hover{background:rgba(10,17,32,.08);color:#B8860B;}
    </style>
    <script>
    (function(){
      var menu=document.getElementById('tsmMenu');
      if(!menu) return;
      function openM(){ menu.classList.add('open'); menu.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }
      function closeM(){ menu.classList.remove('open'); menu.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
      var tries=0;
      var iv=setInterval(function(){
        tries++;
        var btn=document.getElementById('open-menu');
        if(!btn){ if(tries>120) clearInterval(iv); return; }
        clearInterval(iv);
        btn.addEventListener('click', function(e){ e.preventDefault(); openM(); });
        menu.querySelector('.tsm-menu-close').addEventListener('click', closeM);
        menu.querySelector('.tsm-menu-backdrop').addEventListener('click', closeM);
        document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeM(); });
        menu.querySelectorAll('.tsm-toggle').forEach(function(t){
          t.addEventListener('click', function(e){ e.preventDefault(); t.parentElement.classList.toggle('open'); });
        });
      }, 100);
    })();
    </script>
